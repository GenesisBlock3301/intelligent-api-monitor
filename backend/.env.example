PORT=4000
DATABASE_URL=postgresql://api_sentinel:api_sentinel@localhost:5432/api_sentinel
REDIS_URL=redis://localhost:6379
HIGH_LATENCY_THRESHOLD_MS=3000
MAX_MONITOR_BATCH_SIZE=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

LLM_TIMEOUT_MS=4000

# Comma-separated browser origins allowed to call the API.
# http://localhost:3000 and http://127.0.0.1:3000 are always included.
# Use explicit origins. A wildcard is rejected.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
