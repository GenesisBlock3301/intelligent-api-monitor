# Docker Compose reads this file for build args and container environment.
# Copy to .env beside docker-compose.yml. Do not commit .env.
# Leave these at the local defaults for development.

VITE_API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ubuntu VM 10.250.140.136. The dashboard uses the page address, and frontend
# Nginx proxies API paths to the backend. Replace CORS_ORIGINS before starting:
# CORS_ORIGINS=http://10.250.140.136:3000,http://10.250.140.136,http://localhost:3000,http://127.0.0.1:3000
